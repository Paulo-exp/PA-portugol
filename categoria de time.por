programa {
  funcao inicio() {
   cadeia idade

   escreva("Digite sua idade por favor ")
   leia(idade)

   escolha (idade) {
    caso 1: 
    
    escreva("Sua idade e de 05 a 10 anos é categoria Infantil ")
    pare

     caso 2: 
    escreva("Sua idade e de 11 a 15 anos é categoria Juvenil ")
    pare

     caso 3: 
    escreva("Sua idade e de 16 a 20 anos é categoiria Junior ")
    pare

     caso 4: 
    escreva("Sua idade e de 21 a 25 anos é categoria Profissional ")
    pare
   }

  }
}
